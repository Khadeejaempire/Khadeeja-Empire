# Supabase
# Supabase mode is enabled only when all three values are configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# PayU Hosted Checkout (server-only key and salt)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test
NEXT_PUBLIC_SITE_URL=https://www.khadeejaempire.com

# Brevo transactional email (server-only, no NEXT_PUBLIC_ prefix)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@khadeejaempire.com
BREVO_SENDER_NAME=Khadeeja Empire
